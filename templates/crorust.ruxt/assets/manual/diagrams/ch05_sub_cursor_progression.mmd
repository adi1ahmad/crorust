        Widget1["2. Allocate Label (size: 200.0, 20.0)<br/>Assigned Rect: (10.0, 10.0) -> (210.0, 30.0)<br/>Cursor advances down by: 20.0 + item_spacing.y (8.0)<br/>New Cursor: (10.0, 38.0)"]:::rect
        Widget2["3. Allocate Button (size: 150.0, 32.0)<br/>Assigned Rect: (10.0, 38.0) -> (160.0, 70.0)<br/>Cursor advances down by: 32.0 + item_spacing.y (8.0)<br/>New Cursor: (10.0, 78.0)"]:::rect
        Final["4. Container Complete<br/>min_rect expanded to encompass all widgets:<br/>(10.0, 10.0) -> (210.0, 70.0)"]:::step
