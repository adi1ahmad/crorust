# =============================================================================
# DIRENV CONFIGURATION — Fast, Silent Automatic Flake Loading
# =============================================================================
export NIX_SHELL_SILENT=1

# Re-evaluate direnv automatically when toolchain or Nix module files change
watch_file flake.nix
watch_file flake.lock
watch_file rust-toolchain.toml
watch_file nix/versions.nix
watch_file nix/dependencies.nix
watch_file nix/environment.nix
watch_file nix/overlays.nix

use flake

# Ensure Nix build temp dirs don't leak into long-lived interactive sessions
unset TMPDIR TMP TEMP TEMPDIR